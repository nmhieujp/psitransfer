doctype html
html(lang=(lang && lang.langCode) || 'en')
  head
    include partials/head
    include partials/head_custom
  body
    - var pageKind = 'error'
    include partials/header
    main.site-main
      .container
        .error-card
          p.alert.alert-danger
            strong= error
          p
            a.btn.btn-primary(href=uploadAppPath data-i18n='newUpload')= (lang && lang.newUpload) || 'New upload'
    include partials/footer
    script(src='assets/lang-switch.js')
