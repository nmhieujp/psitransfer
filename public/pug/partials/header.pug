      span.brand-text
        span.brand-name PsiTransfer
        if pageKind === 'admin'
          span.brand-badge(data-i18n='admin')= (lang && lang.admin) || 'Admin'
        else
          span.brand-tagline(data-i18n='tagline')= (lang && lang.tagline) || 'A private place to pass files along.'
