script.
  (function () {
    var stored = '';
    try { stored = localStorage.getItem('psitransfer.lang') || ''; } catch (e) {}
    if (stored !== 'en' && stored !== 'ja' && stored !== 'vi') {
      window.PSITRANSFER_LANG = '';
      return;
    }
    window.PSITRANSFER_LANG = stored;
    document.documentElement.lang = stored;
    var match = document.cookie.match(/(?:^|;\s*)psitransfer_lang=([a-z-]+)/);
    var current = match ? match[1] : '';
    if (current === stored) return;
    document.cookie = 'psitransfer_lang=' + stored + '; Path=/; Max-Age=31536000; SameSite=Lax';
    var check = document.cookie.match(/(?:^|;\s*)psitransfer_lang=([a-z-]+)/);
    if (check && check[1] === stored) location.reload();
  })();
