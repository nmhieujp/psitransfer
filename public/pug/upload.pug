doctype html
html(lang=(lang && lang.langCode) || 'en')
  head
    include partials/head
    include partials/head_custom
  body
    #dropHelper
      span.drop-helper-label(data-i18n='dropFilesHere')= (lang && lang.dropFilesHere) || 'Drop your files here'
    - var pageKind = 'upload'
    include partials/header
    main.site-main
      .container
        #upload
    include partials/footer
    script(src='assets/lang-switch.js')
    script(src='app/common.js')
    script PSITRANSFER_UPLOAD_PATH = '#{uploadAppPath}';
    script(src='app/upload.js')
